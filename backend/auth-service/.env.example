# Copy to .env for local runs. NEVER commit the real .env file.
MONGO_URL=mongodb://localhost:27017
DB_NAME=inventory_db
# JWT_SECRET must be IDENTICAL in all three services.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password-8+-chars-letter-and-number
# Create demo accounts manager / warehouse / sales (set false in production)
SEED_DEMO_USERS=true
# Lock an account for LOCKOUT_MINUTES after MAX_FAILED_ATTEMPTS wrong passwords
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
CORS_ORIGINS=http://localhost:5173
